{
  "name": "counterparts",
  "version": "0.3.13",
  "license": "MIT",
  "description": "Memory that turns AI tools into counterparts - a local-first, human-memory-modeled memory layer for AI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlapeter/counterparts.git"
  },
  "homepage": "https://counterparts.ai",
  "bugs": {
    "url": "https://github.com/mlapeter/counterparts/issues"
  },
  "keywords": [
    "memory",
    "ai",
    "claude",
    "mcp",
    "local-first"
  ],
  "type": "module",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.15.0"
  },
  "bin": {
    "counterparts": "./src/adapters/cli/bin/counterparts.mjs",
    "counterparts-hook": "./src/adapters/claude-code/bin/hook.mjs",
    "counterparts-mcp": "./src/adapters/mcp/bin/serve.mjs",
    "counterparts-dashboard": "./src/adapters/dashboard/bin/dashboard.mjs"
  },
  "main": "./src/core/counterpart.ts",
  "types": "./src/core/counterpart.ts",
  "exports": {
    ".": "./src/core/counterpart.ts",
    "./store": "./src/core/store/index.ts",
    "./claude-code": "./src/adapters/claude-code/index.ts",
    "./mcp": "./src/adapters/mcp/index.ts",
    "./cli": "./src/adapters/cli/commands.ts",
    "./dashboard": "./src/adapters/dashboard/index.ts",
    "./sessions": "./src/adapters/sessions.ts",
    "./scopes": "./src/adapters/scopes.ts",
    "./lifecycle": "./src/adapters/lifecycle.ts",
    "./hosts": "./src/adapters/hosts.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "docs/QUICKSTART.md",
    "docs/ELI5.md",
    "docs/module-map.md",
    "tools/install-loop/",
    "CONSTITUTION.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "counterparts-model-potion": "^0.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "playwright": "1.62.1",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:node": "node --import ./src/adapters/node-hooks.mjs --test test/node-smoke.ts"
  }
}
