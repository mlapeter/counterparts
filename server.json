{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.counterparts/memory",
  "title": "Counterparts",
  "description": "Local-first memory for AI: it interprets, forgets on purpose, and keeps a self across sessions.",
  "websiteUrl": "https://counterparts.ai",
  "repository": {
    "url": "https://github.com/mlapeter/counterparts",
    "source": "github"
  },
  "version": "0.3.50",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "counterparts",
      "version": "0.3.50",
      "runtimeHint": "npx",
      "runtimeArguments": [
        { "type": "positional", "value": "-y" },
        { "type": "positional", "value": "-p" }
      ],
      "packageArguments": [
        { "type": "positional", "value": "counterparts-mcp" }
      ],
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "COUNTERPARTS_DATA_DIR",
          "description": "Where the memory lives. Default: ~/.counterparts/store.",
          "isRequired": false
        },
        {
          "name": "COUNTERPARTS_CONFIG",
          "description": "The host configuration file. Default: ~/.counterparts/claude-code.json.",
          "isRequired": false
        },
        {
          "name": "COUNTERPARTS_UPDATE_CHECK",
          "description": "Set to off to stop the daily npm version check.",
          "isRequired": false
        }
      ]
    }
  ]
}
